+def test_the_trim_s_cost_does_not_grow_with_the_output(tmp_path, monkeypatch):
+    """Relative, not a wall clock: 8 times the output costs about the same once trimmed."""
+    install_secret(tmp_path)
+    monkeypatch.setattr(shaping, "TRIM_CHARS", 1_000_000)
+    line = f"epoch 1 - loss 0.25 - token=abc123def456 - db {PASSWORD}\n"
+
+    def best(size: int) -> float:
+        outputs = [stream(line * (size // len(line)))]
+        times = []
+        for _ in range(3):
+            began = time.perf_counter()
+            shape(outputs)
+            times.append(time.perf_counter() - began)
+        return min(times)
+
+    small, large = best(2_000_000), best(16_000_000)
+    assert large < 3 * small, (small, large)
