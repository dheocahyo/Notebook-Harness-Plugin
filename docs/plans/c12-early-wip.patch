diff --git a/tests/unit/test_kernel_utf8.py b/tests/unit/test_kernel_utf8.py
new file mode 100644
index 0000000..b2e56d0
--- /dev/null
+++ b/tests/unit/test_kernel_utf8.py
@@ -0,0 +1,84 @@
+"""a7's receive-path fix (design §6.13): the kernel websocket's text frames are checked as UTF-8
+by the C decoder, not websocket-client's pure-Python loop (~0.2 s per MB without ``wsaccel``).
+
+The check must refuse what websocket-client refused (its own check, or ``WebSocketApp``'s decode of
+a text frame, which catches a sequence cut at the end), and its frame reader must still call it by
+that name. Against websocket-client's latest release (the drift job), a7's receive budget
+(``tests/integration/test_large_outputs.py``) is what fails if it doesn't.
+"""
+
+from __future__ import annotations
+
+import pytest
+import websocket._abnf
+import websocket._utils
+from websocket._abnf import ABNF, continuous_frame
+from websocket._exceptions import WebSocketPayloadException
+
+from nh_gateway.backend import kernel
+
+VALID = [
+    b"",
+    b"plain ascii",
+    "café 😀 ✓ ∑".encode(),
+    b'{"msg_type": "stream", "text": "' + b"x" * 100_000 + b'"}',
+    b"\xf4\x8f\xbf\xbf",  # U+10FFFF, the last code point
+]
+INVALID = [
+    b"\xff",  # never valid
+    b"\xc0\xaf",  # overlong "/"
+    b"\xe0\x80\xaf",  # overlong, three bytes
+    b"\xed\xa0\x80",  # a UTF-16 surrogate
+    b"\xe2\x82",  # cut short
+    b"ok \x80 then",  # a stray continuation byte
+    b"\xf4\x90\x80\x80",  # past U+10FFFF
+]
+
+
+def refused_before(data: bytes) -> bool:
+    """websocket-client on its own: its check, then ``WebSocketApp``'s decode of the text."""
+    if not websocket._utils.validate_utf8(data):
+        return True
+    try:
+        data.decode("utf-8")
+    except UnicodeDecodeError:
+        return True
+    return False
+
+
+def text_frame(data: bytes) -> tuple[int, ABNF]:
+    """One whole text frame through websocket-client's own reader, as a kernel message arrives."""
+    frames = continuous_frame(fire_cont_frame=False, skip_utf8_validation=False)
+    frame = ABNF(fin=1, opcode=ABNF.OPCODE_TEXT, data=data)
+    frames.validate(frame)
+    frames.add(frame)
+    return frames.extract(frame)
+
+
+def test_the_frame_reader_calls_nh_s_check():
+    assert websocket._abnf.validate_utf8 is kernel.validate_utf8
+    assert "validate_utf8" in continuous_frame.extract.__code__.co_names
+
+
+@pytest.mark.parametrize("data", VALID)
+def test_valid_text_frames_pass(data: bytes):
+    assert kernel.validate_utf8(data) and not refused_before(data)
+    opcode, frame = text_frame(data)
+    assert opcode == ABNF.OPCODE_TEXT and frame.data == data
+
+
+@pytest.mark.parametrize("data", INVALID)
+def test_invalid_text_frames_are_refused_as_before(data: bytes):
+    assert refused_before(data)
+    assert not kernel.validate_utf8(data)
+    with pytest.raises(WebSocketPayloadException):
+        text_frame(data)
+
+
+def test_other_buffers_and_str_are_checked_like_websocket_client_does():
+    for data in (bytearray("é".encode()), memoryview("é".encode())):
+        assert kernel.validate_utf8(data)
+    assert not kernel.validate_utf8(bytearray(b"\xff"))
+    assert kernel.validate_utf8("é")
+    assert not kernel.validate_utf8("\ud800")  # a lone surrogate
+    assert not websocket._utils.validate_utf8("\ud800")
diff --git a/tests/unit/test_rtc_save.py b/tests/unit/test_rtc_save.py
new file mode 100644
index 0000000..a89c512
--- /dev/null
+++ b/tests/unit/test_rtc_save.py
@@ -0,0 +1,174 @@
+"""a8's fix (design §6.13): nh asks the room to save after each of its writes and each run.
+
+jupyter-collaboration saves a room only after ``document_save_delay`` with no change, so while a
+cell prints nothing reaches the file; after a JupyterLab restart the room takes the file over its
+YStore and the unsaved cells are gone. The integration tests (``test_lab_restart.py``) show the
+loss and the fix against a real JupyterLab; these pin the pieces.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+from pycrdt import Decoder
+from websockets.exceptions import ConnectionClosedError
+
+from nh_gateway._shared.paths import Layout
+from nh_gateway.backend.base import CellPatch, NewCell, NotebookRef
+from nh_gateway.backend.rtc import RAW_MESSAGE, NhNbModelClient, RtcDocument, save_message
+from nh_gateway.backend.rtc_backend import RtcBackend
+from nh_gateway.config import ConfigCache
+
+NB = "notebooks/01_eda.ipynb"
+
+
+class Socket:
+    """The room websocket: what nh sent on it."""
+
+    def __init__(self, fail: bool = False) -> None:
+        self.sent: list[bytes] = []
+        self.fail = fail
+
+    async def send(self, message: bytes) -> None:
+        if self.fail:
+            raise ConnectionClosedError(None, None)
+        self.sent.append(message)
+
+
+def decoded(message: bytes) -> tuple[int, str, int]:
+    """Read a save request the way jupyter-collaboration's YDocWebSocketHandler does."""
+    decoder = Decoder(message)
+    return decoder.read_var_uint(), decoder.read_var_string(), decoder.read_var_uint()
+
+
+def test_the_save_message_is_jupyter_collaborations_raw_save() -> None:
+    assert RAW_MESSAGE == 2
+    assert decoded(save_message(1)) == (2, "save", 1)
+    assert decoded(save_message(300)) == (2, "save", 300)
+
+
+async def test_the_client_saves_once_the_room_answered_and_ignores_the_reply() -> None:
+    client = NhNbModelClient("ws://127.0.0.1:9/room", username="nh-agent")
+    assert await client.request_save() is False  # no connection yet: nothing to send on
+    socket = Socket()
+    reply = bytes([RAW_MESSAGE]) + b'{"type": "save", "responseTo": 1, "status": "success"}'
+    await client._on_message(socket, reply)  # the room's answer to a save: ignored
+    assert await client.request_save() is True
+    assert await client.request_save() is True
+    assert [decoded(m) for m in socket.sent] == [(2, "save", 1), (2, "save", 2)]
+
+
+class Nb:
+    """A synced room client for RtcDocument."""
+
+    def __init__(self, fail: bool = False) -> None:
+        self.saves = 0
+        self.fail = fail
+        self.synced = True
+
+    async def request_save(self) -> bool:
+        if self.fail:
+            raise ConnectionClosedError(None, None)
+        self.saves += 1
+        return True
+
+
+async def room(nb: Nb | None) -> RtcDocument:
+    doc = RtcDocument(api=None, api_path=NB)  # type: ignore[arg-type]
+    doc.nb = nb  # type: ignore[assignment]
+    doc._task = asyncio.create_task(asyncio.sleep(3600))
+    return doc
+
+
+async def test_the_document_asks_only_while_synced_and_never_fails_a_write(caplog) -> None:
+    caplog.set_level(logging.INFO, logger="nh_gateway.rtc")
+    nb = Nb()
+    doc = await room(nb)
+    try:
+        await doc.save()
+        assert nb.saves == 1
+        nb.synced = False  # the room dropped: the next write reconnects first
+        await doc.save()
+        assert nb.saves == 1
+        nb.synced, nb.fail = True, True  # the connection dropped under the request
+        await doc.save()
+        assert "save request for notebooks/01_eda.ipynb not sent" in caplog.text
+    finally:
+        assert doc._task is not None
+        doc._task.cancel()
+    await (await room(None)).save()  # never connected: nothing to do
+
+
+class WriteDoc:
+    """The backend's room for one notebook: the order of nh's writes and save requests."""
+
+    upgraded_minor = False
+
+    def __init__(self) -> None:
+        self.calls: list[str] = []
+
+    def insert(self, index: int, cells: list[NewCell]) -> None:
+        self.calls.append("insert")
+
+    def update(self, patches: list[CellPatch]) -> None:
+        self.calls.append("update")
+
+    def delete(self, ids: list[str]) -> list:
+        self.calls.append("delete")
+        return []
+
+    def set_meta(self, key: str, value: Any) -> None:
+        self.calls.append("set_meta")
+
+    async def save(self) -> None:
+        self.calls.append("save")
+
+
+@pytest.fixture
+def backend(tmp_path: Path, monkeypatch) -> Iterator[tuple[RtcBackend, WriteDoc, NotebookRef]]:
+    project = tmp_path / "proj"
+    (project / ".nh" / "state" / "running").mkdir(parents=True)
+    rtc = RtcBackend(Layout(project), ConfigCache(project))
+    doc = WriteDoc()
+
+    async def the_doc(ref: NotebookRef) -> WriteDoc:
+        return doc
+
+    monkeypatch.setattr(rtc, "_doc", the_doc)
+    ref = NotebookRef(abs_path=project / NB, api_path=NB, rel_path=NB)
+    yield rtc, doc, ref
+    rtc._pool.shutdown(wait=False)
+
+
+async def test_every_backend_write_asks_the_room_to_save_after_it(backend) -> None:
+    rtc, doc, ref = backend
+    await rtc.insert_cells(ref, -1, [NewCell(id="c", cell_type="code", source="x", metadata={})])
+    await rtc.update_cells(ref, [CellPatch(id="c", source="y")])
+    await rtc.delete_cells(ref, ["c"])
+    await rtc.set_notebook_meta(ref, "nh", {"v": 1})
+    assert doc.calls == [
+        "insert",
+        "save",
+        "update",
+        "save",
+        "delete",
+        "save",
+        "set_meta",
+        "save",
+    ]
+
+
+async def test_a_finished_run_drops_its_record_and_asks_for_a_save(backend) -> None:
+    rtc, doc, _ref = backend
+    record = rtc._running_file("c")
+    record.write_text(json.dumps({"cell_id": "c"}))
+    rtc._run_done("c", doc)  # type: ignore[arg-type]
+    assert not record.exists()
+    await asyncio.gather(*rtc._saves)
+    assert doc.calls == ["save"] and not rtc._saves
