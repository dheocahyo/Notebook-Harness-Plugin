+def _scan_args(code: str) -> tuple[Any, list[str], Any]:
+    """What lint_cell hands the scan for a Python cell."""
+    source = "\n".join(lines_of(code))
+    masked = mask(source)
+    return masked, lines_of(source), ast.parse(masked.text)
