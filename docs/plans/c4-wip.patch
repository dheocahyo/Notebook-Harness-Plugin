+def test_l011_scan_cost_is_linear() -> None:
+    body = "\n".join(f"x{i} = os.getenv('K{i}')\nprint(len(x{i}))" for i in range(400))
+    code = "import os\n" + body
+    deep = "import os\nkey = os.getenv('K')\n" + "".join(
+        "    " * i + f"for i{i} in range(2):\n" + "    " * (i + 1) + f"v{i} = key\n"
+        for i in range(12)
+    )
+    for cell in (code, deep):
+        started = time.perf_counter()
+        secret_scan.scan(*_scan_args(cell))
+        assert time.perf_counter() - started < 1.0
